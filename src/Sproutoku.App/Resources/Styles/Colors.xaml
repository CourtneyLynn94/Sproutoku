<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Sproutoku's palette: the only place colors are written down.
         XAML uses these names ({StaticResource Ink}); C# reads them through Palette.
         Android's own status bar colors are in Platforms/Android/Resources/values/colors.xml. -->

    <!-- Paper and ink -->
    <Color x:Key="Ink">#2E241B</Color>      <!-- text, outlines, ✕ marks -->
    <Color x:Key="InkSoft">#6B5B49</Color>  <!-- second lines and notes -->
    <Color x:Key="Paper">#F3EDD6</Color>    <!-- page background -->
    <Color x:Key="Cream">#FBF7EA</Color>    <!-- cards: planting list, worm's note; hint previews -->

    <!-- The garden's surroundings -->
    <Color x:Key="Sky">#D6EAE8</Color>      <!-- the sky band with the suns -->
    <Color x:Key="Wood">#B98A5B</Color>     <!-- the garden sign -->
    <Color x:Key="Plank">#CDBF9B</Color>    <!-- the tool shelf's divider -->
    <Color x:Key="Sun">#F2B632</Color>
    <Color x:Key="SpentSun">#D9CFB6</Color>

    <!-- Plants -->
    <Color x:Key="Leaf">#487634</Color>     <!-- a grown plant -->
    <Color x:Key="Wilt">#8E3F45</Color>     <!-- a wilted plant, a wrong ✕ -->

    <!-- Beds, in bed-id order (the same order as BedNames) -->
    <Color x:Key="BedSoil">#B08560</Color>
    <Color x:Key="BedWater">#9FCAD4</Color>
    <Color x:Key="BedSand">#EBD498</Color>
    <Color x:Key="BedPerlite">#E4E2D8</Color>
    <Color x:Key="BedPebble">#AEB4B3</Color>
    <Color x:Key="BedBark">#D69A5C</Color>
    <Color x:Key="BedMoss">#A9C47B</Color>
    <Color x:Key="BedClay">#E0A090</Color>
    <Color x:Key="BedMulch">#A59C6C</Color>
    <Color x:Key="BedLava">#B79CB2</Color>

    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource Ink}" />

    <!-- MAUI's default styles (Styles.xaml) use the names below.
         They now hold Sproutoku colors instead of the template's purples, so buttons, switches and the like match the game. -->
    <Color x:Key="Primary">#487634</Color>      <!-- buttons: leaf -->
    <Color x:Key="PrimaryDark">#A9C47B</Color>  <!-- buttons on a dark device theme: moss -->
    <Color x:Key="PrimaryDarkText">#2E241B</Color>
    <Color x:Key="Secondary">#A9C47B</Color>    <!-- a switch that's on: moss -->
    <Color x:Key="SecondaryDarkText">#A9C47B</Color>
    <Color x:Key="Tertiary">#2E241B</Color>
    <Color x:Key="Magenta">#487634</Color>
    <Color x:Key="MidnightBlue">#2E241B</Color>
    <Color x:Key="OffBlack">#1E1812</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}" />
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}" />
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}" />
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}" />
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}" />
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}" />
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}" />
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}" />
</ResourceDictionary>
