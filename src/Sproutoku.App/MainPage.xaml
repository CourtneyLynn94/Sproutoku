<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sproutoku.App.MainPage"
             BackgroundColor="#F3EDD6">

    <Grid RowDefinitions="Auto,*,Auto"
          RowSpacing="16"
          Padding="16">
        <Label x:Name="InfoLabel"
               TextColor="#2E241B"
               HorizontalOptions="Center" />

        <GraphicsView x:Name="GardenView"
                      Grid.Row="1" />

        <VerticalStackLayout x:Name="BottomBar"
                             Grid.Row="2"
                             Spacing="8"
                             HorizontalOptions="Center">
            <Button Text="New garden"
                    Clicked="OnNewGardenClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
