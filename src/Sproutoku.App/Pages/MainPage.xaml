<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Sproutoku.App.ViewModels"
             xmlns:controls="clr-namespace:Sproutoku.App.Controls"
             xmlns:garden="clr-namespace:Sproutoku.App.Controls.Garden"
             x:Class="Sproutoku.App.Pages.MainPage"
             x:DataType="viewModels:GardenViewModel"
             BackgroundColor="{StaticResource Paper}">

    <Grid RowDefinitions="Auto,*">

        <!-- Sky band: journal button on the left, suns centered. -->
        <Grid BackgroundColor="{StaticResource Sky}"
              Padding="16,8"
              ColumnDefinitions="*,Auto,*">
            <Button Text="Journal"
                    Command="{Binding OpenJournalCommand}"
                    HorizontalOptions="Start" />

            <controls:SunMeter Grid.Column="1"
                               VerticalOptions="Center"
                               StartingSuns="{Binding StartingSuns}"
                               SunsLeft="{Binding SunsLeft}"
                               SemanticProperties.Description="{Binding SunsDescription}" />
        </Grid>

        <!-- Game area. ApplyLayout places these three parts for phone or desktop. -->
        <Grid x:Name="GameArea"
              Grid.Row="1"
              Padding="16"
              RowSpacing="12"
              ColumnSpacing="16">

            <!-- Board, with the garden sign above its top-left corner. -->
            <Grid x:Name="BoardArea"
                  RowDefinitions="Auto,*"
                  RowSpacing="4">
                <Border BackgroundColor="{StaticResource Wood}"
                        Stroke="{StaticResource InkBrush}"
                        StrokeThickness="2"
                        Padding="12,4"
                        HorizontalOptions="Start">
                    <Label Text="{Binding GardenName}"
                           TextColor="{StaticResource Ink}"
                           FontAttributes="Bold" />
                </Border>

                <garden:GardenView x:Name="Garden"
                                   Grid.Row="1" />
            </Grid>

            <!-- Planting list placeholder. -->
            <controls:PlantingList x:Name="PlantingList"
                                   IsVisible="{Binding IsPlantingListShown}"
                                   VerticalOptions="Start" />

            <!-- The worm's note: shown in the planting list's place while a hint is open. -->
            <controls:WormNote x:Name="WormNote"
                               IsVisible="{Binding IsHintOpen}"
                               VerticalOptions="Start" />

            <!-- Tool shelf placeholder: Seeds, Worm, Water | Rake. -->
            <controls:ToolShelf x:Name="ToolShelf"
                                VerticalOptions="Start" />
        </Grid>
    </Grid>
    
</ContentPage>
