<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Sproutoku.App.ViewModels"
             xmlns:controls="clr-namespace:Sproutoku.App.Controls"
             xmlns:garden="clr-namespace:Sproutoku.App.Controls.Garden"
             x:Class="Sproutoku.App.Pages.MainPage"
             x:DataType="viewModels:GardenViewModel"
             BackgroundColor="{StaticResource Paper}">

    <Grid RowDefinitions="Auto,*">

        <!-- Sky band: journal button on the left, suns centered. -->
        <Grid BackgroundColor="{StaticResource Sky}"
              Padding="16,8"
              ColumnDefinitions="*,Auto,*">
            <Button Text="Journal"
                    Command="{Binding OpenJournalCommand}"
                    HorizontalOptions="Start" />

            <HorizontalStackLayout x:Name="SunMeter"
                                   Grid.Column="1"
                                   Spacing="8"
                                   VerticalOptions="Center"
                                   SemanticProperties.Description="{Binding SunsDescription}" />
        </Grid>

        <!-- Game area. ApplyLayout places these three parts for phone or desktop. -->
        <Grid x:Name="GameArea"
              Grid.Row="1"
              Padding="16"
              RowSpacing="12"
              ColumnSpacing="16">

            <!-- Board, with the garden sign above its top-left corner. -->
            <Grid x:Name="BoardArea"
                  RowDefinitions="Auto,*"
                  RowSpacing="4">
                <Border BackgroundColor="{StaticResource Wood}"
                        Stroke="{StaticResource InkBrush}"
                        StrokeThickness="2"
                        Padding="12,4"
                        HorizontalOptions="Start">
                    <Label Text="{Binding GardenName}"
                           TextColor="{StaticResource Ink}"
                           FontAttributes="Bold" />
                </Border>

                <GraphicsView x:Name="GardenView"
                              Grid.Row="1" />
            </Grid>

            <!-- Planting list placeholder. -->
            <Border x:Name="PlantingList"
                    IsVisible="{Binding IsPlantingListShown}"
                    BackgroundColor="{StaticResource Cream}"
                    Stroke="{StaticResource InkBrush}"
                    StrokeThickness="2"
                    Padding="12"
                    VerticalOptions="Start">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Planting list"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Ink}" />
                    <Label Text="{Binding PlantingCount}"
                           TextColor="{StaticResource Ink}" />
                    <Label Text="{Binding Info}"
                           TextColor="{StaticResource InkSoft}" />
                </VerticalStackLayout>
            </Border>

            <!-- The worm's note: shown in the planting list's place while a hint is open. -->
            <Border x:Name="WormNote"
                    IsVisible="{Binding IsHintOpen}"
                    BackgroundColor="{StaticResource Cream}"
                    Stroke="{StaticResource InkBrush}"
                    StrokeThickness="2"
                    Padding="12"
                    VerticalOptions="Start">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Your worm says"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Ink}" />
                    <Label Text="{Binding HintMessage}"
                           TextColor="{StaticResource Ink}" />
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Apply"
                                Command="{Binding ApplyHintCommand}"
                                IsVisible="{Binding IsHintFocused}" />
                        <Button Text="Hide"
                                Command="{Binding HideHintCommand}"
                                IsVisible="{Binding IsHintFocused}" />
                        <Button Text="Show"
                                Command="{Binding ShowHintCommand}"
                                IsVisible="{Binding IsHintHidden}" />
                        <Button Text="Close"
                                Command="{Binding CloseHintCommand}"
                                IsVisible="{Binding IsHintHidden}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Tool shelf placeholder: Seeds, Worm, Water | Rake. -->
            <controls:ToolShelf x:Name="ToolShelf"
                                VerticalOptions="Start" />
        </Grid>
    </Grid>
    
</ContentPage>
