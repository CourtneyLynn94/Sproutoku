<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sproutoku.App.Pages.SettingsPage"
             BackgroundColor="#F3EDD6">

    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="#2E241B" />
            <Setter Property="FontSize" Value="17" />
        </Style>
        <!-- The second line under each setting: what it does, or "Coming soon". -->
        <Style x:Key="Note" TargetType="Label">
            <Setter Property="TextColor" Value="#6B5B49" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="24"
                             Spacing="20"
                             MaximumWidthRequest="480">
            <Label Text="Settings"
                   FontSize="28"
                   FontAttributes="Bold" />

            <!-- One row per setting: the name and a note on the left, the switch on the right. -->
            <Grid x:Name="VibrationRow" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout>
                    <Label Text="Vibration" FontAttributes="Bold" />
                    <Label Style="{StaticResource Note}"
                           Text="A click when you mark, plant or make a mistake." />
                </VerticalStackLayout>
                <Switch x:Name="VibrationSwitch"
                        Grid.Column="1"
                        VerticalOptions="Center"
                        SemanticProperties.Description="Vibration"
                        SemanticProperties.Hint="A click when you mark, plant or make a mistake." />
            </Grid>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout>
                    <Label Text="Bed patterns" FontAttributes="Bold" />
                    <Label x:Name="BedPatternsNote"
                           Style="{StaticResource Note}"
                           Text="Coming soon: a pattern on each bed, so beds can be told apart without color." />
                </VerticalStackLayout>
                <Switch x:Name="BedPatternsSwitch"
                        Grid.Column="1"
                        VerticalOptions="Center"
                        IsEnabled="False"
                        SemanticProperties.Description="Bed patterns"
                        SemanticProperties.Hint="Coming soon: a pattern on each bed, so beds can be told apart without color." />
            </Grid>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout>
                    <Label Text="Sound" FontAttributes="Bold" />
                    <Label Style="{StaticResource Note}" Text="Coming soon." />
                </VerticalStackLayout>
                <Switch x:Name="SoundSwitch"
                        Grid.Column="1"
                        VerticalOptions="Center"
                        IsEnabled="False"
                        SemanticProperties.Description="Sound"
                        SemanticProperties.Hint="Coming soon." />
            </Grid>

            <VerticalStackLayout>
                <Label Text="Light" FontAttributes="Bold" />
                <Label Style="{StaticResource Note}" Text="Coming soon: Morning, Dusk, or match your device." />
            </VerticalStackLayout>

            <Label x:Name="VersionLabel" Style="{StaticResource Note}" />
            <Button Text="Done"
                    HorizontalOptions="Start"
                    Clicked="OnDoneClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
