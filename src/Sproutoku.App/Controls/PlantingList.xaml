<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:Sproutoku.App.Pages"
             x:Class="Sproutoku.App.Controls.PlantingList"
             x:DataType="pages:GardenViewModel">

    <!-- Placeholder: the count and the info line. The bed list arrives with #93. -->
    <Border BackgroundColor="{StaticResource Cream}"
            Stroke="{StaticResource InkBrush}"
            StrokeThickness="2"
            Padding="12">
        <VerticalStackLayout Spacing="4">
            <Label Text="Planting list"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Ink}" />
            <Label Text="{Binding PlantingCount}"
                   TextColor="{StaticResource Ink}" />
            <Label Text="{Binding Info}"
                   TextColor="{StaticResource InkSoft}" />
        </VerticalStackLayout>
    </Border>
</ContentView>
